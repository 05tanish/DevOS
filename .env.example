# ─────────────────────────────────────────────
# DATABASE — Neon DB (https://console.neon.tech)
# ─────────────────────────────────────────────
# Pooled connection (app runtime)
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.c-9.us-east-1.aws.neon.tech/neondb?sslmode=require&pgbouncer=true

# Direct connection (Prisma migrations only)
DIRECT_URL=postgresql://USER:PASSWORD@ep-xxx.c-9.us-east-1.aws.neon.tech/neondb?sslmode=require

# ─────────────────────────────────────────────
# AUTH
# ─────────────────────────────────────────────
JWT_SECRET=your-256-bit-secret-minimum-32-characters-long
JWT_EXPIRY=7d
ALLOWED_EMAILS=your@email.com

# ─────────────────────────────────────────────
# APP
# ─────────────────────────────────────────────
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# IMPORTANT: Set BACKEND_URL in production to the full backend URL
# This ensures file URLs work correctly in production
# Example for Railway: https://your-app-name.up.railway.app
# Leave empty in development (will default to http://localhost:PORT)
BACKEND_URL=

# ─────────────────────────────────────────────
# EMAIL — Resend (https://resend.com)
# ─────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=DevOS <onboarding@resend.dev>

# ─────────────────────────────────────────────
# TELEGRAM (optional — for reminders)
# ─────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─────────────────────────────────────────────
# CLOUDINARY (file storage - PRIMARY)
# Get from Cloudinary Dashboard > Account Settings
# https://cloudinary.com
# ─────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here

# ─────────────────────────────────────────────
# SUPABASE (optional — LEGACY file storage)
# Get from Supabase Dashboard > Project Settings > API
# Being replaced by Cloudinary
# ─────────────────────────────────────────────
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=devos-files

# ─────────────────────────────────────────────
# REDIS — Upstash (https://upstash.com)
# ─────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=https://your-upstash-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# ─────────────────────────────────────────────
# OPENAI (optional — for AI research features)
# Get from https://platform.openai.com/api-keys
# ─────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-api-key-here

# ─────────────────────────────────────────────
# GEMINI VISION AI (optional — for job screenshot extraction)
# Get from https://aistudio.google.com/apikey
# ─────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here
